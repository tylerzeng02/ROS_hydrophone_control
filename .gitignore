# CMake build output -- but track the real collected/measured data files
# that live in build/ (that's just where every program in this project
# reads/writes them by default), not the actual build artifacts.
build/*
!build/*.csv
!build/*.md
!build/archive/
cmake-build-*/

# Compiled files
*.o
*.a
*.so
*.out

# Python
__pycache__/
*.pyc

# Future ROS 2 build output
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Editor and OS files
.vscode/
.idea/
.DS_Store
*.swp