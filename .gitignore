# CMake build output -- but track the real collected/measured data files
# that live in build/ (that's just where every program in this project
# reads/writes them by default), not the actual build artifacts.
build/*
!build/*.csv
!build/*.md
cmake-build-*/

# Archive/trash/reference folders -- historical or reference material kept
# on disk for whoever's working locally, deliberately not tracked in git
# (2026-08-19: previously build/archive/ was the one exception that WAS
# tracked; now every archive/trash folder is treated the same way).
build/archive/
calibration/archive/
ros/archive/
trash/
understanding/

# Compiled files
*.o
*.a
*.so
*.out

# Python
__pycache__/
*.pyc

# ROS 2 build output (colcon workspace lives at ros/, not ros2_ws/)
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
ros/build/
ros/install/
ros/log/

# Colcon build output accidentally left at repo root or inside
# calibration/current/ from running colcon from the wrong directory --
# these are pure regenerable artifacts, never meant to be tracked (one
# instance found and removed 2026-08-19 still had a hardcoded path from a
# different machine baked into it).
/install/
/log/
calibration/current/build/
calibration/current/install/
calibration/current/log/

# Editor and OS files
.vscode/
.idea/
.DS_Store
*.swp