<?xml version="1.0" ?>

<robot name="cyton_gamma_1500">

  <!--
    KINEMATIC CALIBRATION USED FOR STANDALONE IK

    Updated with the fitted corrections from this project's NDI-
    based kinematic calibration. Per-joint <axis> and (for
    elbow_pitch/shoulder_yaw/wrist_pitch) <origin xyz> below now reflect
    those corrections; see each joint's own inline comment for the specific
    change and its original nominal value.

    URDF joint              Motor ID   zero tick   safe ticks     scale     corrected?
    shoulder_roll_joint        0          2048      276..3772   0.988203   tilt only (offset skipped: base-frame degeneracy)
    shoulder_pitch_joint       1          2047      851..3231   1.001931   offset+scale+tilt
    shoulder_yaw_joint         2          2060      912..3327   0.964711   offset+scale+tilt+origin
    elbow_pitch_joint          3          2102      799..3307   1.014467   offset+scale+tilt+origin (widened, was 829..3277, see joint's own comment)
    elbow_yaw_joint             4          2078     2060..2130  1.0        NONE — deliberately locked near
                                                                              midpoint in production; its own fit
                                                                              is poorly identified (joint barely
                                                                              moved in the dataset used to fit it)
    wrist_pitch_joint          5          2042      751..3344   1.006796   offset+scale+tilt+origin
    wrist_roll_joint           6          2048      335..3761   1.002933   tilt only (offset skipped: tool-frame degeneracy)

    Motor ID 7 is the gripper and is intentionally excluded from the
    base_link -> virtual_endeffector IK chain.

    NOT integrated here, and not representable in a static URDF at all:
    joint-coupling (3 terms), gravity/elastostatic deflection (7 terms), and
    the shoulder_pitch Fourier term — all pose-dependent, would need a
    real-time correction layer in whatever control stack ends up driving
    this robot, not a geometry change. Backlash compensation is separately
    already implemented as C++ logic in src/dynamixel_motor.cpp (per-joint
    overshoot on direction reversal) and needs porting into that same
    control layer, not this file.

    The limits below were converted using 4096 ticks per revolution.
    Joint axes and positive directions must still be verified physically.
    velocity=1.0 is retained as an unverified planning placeholder.
  -->

  <!-- base -->

  <link name="base_footprint">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://cyton_gamma_1500_description/meshes/base.dae"/>
      </geometry>
    </visual>

    <inertial>
      <mass value="100.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia
        ixx="1.1027"
        iyy="1.1027"
        izz="1.1027"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>

    <collision>
      <origin xyz="0 0.0115 0.047"/>
      <geometry>
        <box size="0.154 0.177 0.094"/>
      </geometry>
    </collision>
  </link>

  <!-- shoulder roll -->

  <joint name="shoulder_roll_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_roll"/>
    <origin rpy="0 0 0" xyz="0 0 0.05315"/>
    <limit
      effort="100.0"
      lower="-2.564816"
      upper="2.644583"
      velocity="1.0"/>
    <!-- Axis tilt correction applied, from the kinematic
         calibration fit.
         Original nominal axis: 0 0 1. (This joint's fitted zero-offset was
         NOT applied to zeroTick in robot_calibration.cpp — entangled with
         the calibration-time base frame's rotation — but axis tilt does
         not share that degeneracy and is safe to apply here.) -->
    <axis xyz="0.013792 0.014877 0.999794"/>
  </joint>

  <link name="shoulder_roll">
    <visual>
      <origin rpy="1.5708 0 0.384" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://cyton_gamma_1500_description/meshes/shoulder_roll.dae"/>
      </geometry>
    </visual>

    <inertial>
      <mass value="50.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia
        ixx=".1027"
        iyy=".1027"
        izz=".1027"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>
  </link>

  <!-- shoulder pitch -->

  <joint name="shoulder_pitch_joint" type="revolute">
    <parent link="shoulder_roll"/>
    <child link="shoulder_pitch"/>
    <origin rpy="0 0 0" xyz="0.0205 0 0.12435"/>
    <limit
      effort="100.0"
      lower="-1.833107"
      upper="1.814699"
      velocity="1.0"/>
    <!-- Axis tilt correction applied, from the kinematic
         calibration fit.
         Original nominal axis: 1 0 0. -->
    <axis xyz="0.998997 -0.043573 -0.010357"/>
  </joint>

  <link name="shoulder_pitch">
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://cyton_gamma_1500_description/meshes/shoulder_pitch.dae"/>
      </geometry>
    </visual>

    <inertial>
      <mass value="20.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia
        ixx=".0827"
        iyy=".0827"
        izz=".0827"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>
  </link>

  <!-- shoulder yaw -->

  <joint name="shoulder_yaw_joint" type="revolute">
    <parent link="shoulder_pitch"/>
    <child link="shoulder_yaw"/>
    <!-- Origin and axis tilt corrections applied, from the
         kinematic calibration fit. Original nominal origin xyz: -0.0215 -0.0205 0.1255
         (only x,z corrected; y untouched by the fit's parameterization).
         Original nominal axis: 0 -1 0. -->
    <origin rpy="0 0 0" xyz="-0.02478414 -0.0205 0.1308452"/>
    <limit
      effort="100.0"
      lower="-1.770214"
      upper="1.934350"
      velocity="1.0"/>
    <axis xyz="-0.027678 -0.999437 0.018973"/>
  </joint>

  <link name="shoulder_yaw">
    <visual>
      <origin rpy="1.5708 0 -1.5708" xyz="0 0 0.0"/>
      <geometry>
        <mesh filename="package://cyton_gamma_1500_description/meshes/shoulder_yaw.dae"/>
      </geometry>
    </visual>

    <inertial>
      <mass value="10.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia
        ixx=".0627"
        iyy=".0627"
        izz=".0627"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>
  </link>

  <!-- elbow pitch -->

  <joint name="elbow_pitch_joint" type="revolute">
    <parent link="shoulder_yaw"/>
    <child link="elbow_pitch"/>
    <!-- Origin and axis tilt corrections applied, from the
         kinematic calibration fit. Original nominal origin xyz: 0.018 0.0206 0.1158.
         Original nominal axis: 1 0 0. -->
    <origin rpy="0 0 0" xyz="0.01656849 0.02722018 0.11356304"/>
    <!-- Limit widened (was lower="-1.961961" upper="1.788622")
         to add a 30-tick margin on each side of jointCalibrations[3]'s
         minTick/maxTick (robot_calibration.cpp) - real-hardware MoveIt
         sessions repeatedly showed the arm's actual settled position
         landing a few ticks up to ~25 ticks past the exact hand-verified
         extreme (ordinary servo settling/backlash noise), which
         MoveIt's CheckStartStateBounds check has zero tolerance for and
         will not plan past. Recomputed directly from the widened
         [799, 3307] tick range, not just delta-adjusted from the old
         values - doing so surfaced that the *previous* limit here had
         quietly drifted ~12-26 ticks tighter than jointCalibrations'
         then-current [829, 3277] anyway (likely stale from an earlier
         zeroTick/scale revision that was never propagated here), so this
         edit also fixes that pre-existing mismatch, not just adds
         margin. -->
    <limit
      effort="100.0"
      lower="-2.027693"
      upper="1.875188"
      velocity="1.0"/>
    <axis xyz="0.999677 -0.024005 0.008304"/>
  </joint>

  <link name="elbow_pitch">
    <visual>
      <origin rpy="1.5708 0 3.1416" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://cyton_gamma_1500_description/meshes/elbow_pitch.dae"/>
      </geometry>
    </visual>

    <inertial>
      <mass value="10.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia
        ixx=".0327"
        iyy=".0327"
        izz=".0327"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>
  </link>

  <!-- elbow yaw -->

  <joint name="elbow_yaw_joint" type="revolute">
    <parent link="elbow_pitch"/>
    <child link="elbow_yaw"/>
    <!-- elbow_yaw_joint deliberately left UNCORRECTED: this
         joint is locked near its calibrated midpoint in production (see
         src/robot_calibration.cpp's jointCalibrations comment) and barely
         moved in the dataset used to fit it, so its own tilt/scale/offset
         correction is poorly identified and not trustworthy — moot anyway
         since it's not meant to move in real use. -->
    <origin rpy="0 0 0" xyz="-0.0171 -0.018 0.09746"/>
    <!-- Limit tightened to match this joint's hardware lock
         (jointCalibrations[4]'s minTick/maxTick, robot_calibration.cpp)
         — MUST stay consistent with that C++ range, not the original wide
         mechanical limit, or MoveIt will plan trajectories the hardware
         safety clamp will reject. Original wide limit was
         lower="-1.727262" upper="1.790156".
         Widened slightly again (was lower="-0.004602"
         upper="0.056757") - 15 ticks of margin added each side of
         jointCalibrations[4]'s range (now [2060, 2130]), same real-
         hardware-settling-noise reasoning as elbow_pitch_joint's limit
         above. Still a deliberately tiny ~4 degree window; this joint
         stays "locked" in every practical sense. -->
    <limit
      effort="100.0"
      lower="-0.027612"
      upper="0.079767"
      velocity="1.0"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="elbow_yaw">
    <visual>
      <origin rpy="1.5708 0 1.5708" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://cyton_gamma_1500_description/meshes/elbow_yaw.dae"/>
      </geometry>
    </visual>

    <inertial>
      <mass value="10.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia
        ixx=".0227"
        iyy=".0227"
        izz=".0227"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>
  </link>

  <!-- wrist pitch -->

  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="elbow_yaw"/>
    <child link="wrist_pitch"/>
    <!-- Origin and axis tilt corrections applied, from the
         kinematic calibration fit. Original nominal origin xyz: 0.02626 0.018 0.0718.
         Original nominal axis: 1 0 0. -->
    <origin rpy="0 0 0" xyz="0.02765348 0.01273746 0.07244612"/>
    <limit
      effort="100.0"
      lower="-1.989573"
      upper="1.988039"
      velocity="1.0"/>
    <axis xyz="0.999044 0.042957 0.008105"/>
  </joint>

  <link name="wrist_pitch">
    <visual>
      <origin rpy="1.5708 0 1.5708" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://cyton_gamma_1500_description/meshes/wrist_pitch.dae"/>
      </geometry>
    </visual>

    <inertial>
      <mass value="10.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia
        ixx=".0127"
        iyy=".0127"
        izz=".0127"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>
  </link>

  <!-- wrist roll -->

  <joint name="wrist_roll_joint" type="revolute">
    <parent link="wrist_pitch"/>
    <child link="wrist_roll"/>
    <origin rpy="0 0 0" xyz="-0.026255 0 0.051425"/>
    <limit
      effort="100.0"
      lower="-2.627709"
      upper="2.618505"
      velocity="1.0"/>
    <!-- Axis tilt correction applied, from the kinematic
         calibration fit.
         Original nominal axis: 0 0 1. (This joint's fitted zero-offset was
         NOT applied to zeroTick in robot_calibration.cpp — entangled with
         the calibration-time tool frame's rotation — but axis tilt does
         not share that degeneracy and is safe to apply here.) -->
    <axis xyz="-0.006451 -0.018572 0.999807"/>
  </joint>

  <link name="wrist_roll">
    <visual>
      <origin rpy="3.1416 0 -1.5708" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://cyton_gamma_1500_description/meshes/wrist_roll.dae"/>
      </geometry>
    </visual>

    <inertial>
      <mass value="10.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia
        ixx=".0027"
        iyy=".0027"
        izz=".0027"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>
  </link>

  <!-- virtual end effector -->

  <joint name="virtual_endeffector_joint" type="fixed">
    <parent link="wrist_roll"/>
    <child link="virtual_endeffector"/>
    <origin rpy="0 0 0" xyz="-0.002316 0.0079 0.079425"/>
  </joint>

  <link name="virtual_endeffector">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.002"/>
      </geometry>
      <material name="grey">
        <color rgba="0.7 0.7 0.7 0.8"/>
      </material>
    </visual>
  </link>

  <!-- Hydrophone probe rod: a thin cylindrical rod attached
       rigidly to virtual_endeffector, representing the physical hydrophone
       probe used to measure ultrasound propagation at points on a skull
       phantom. Dimensions are nominal design values (15cm length, 4mm
       diameter - lengthened from the original 10cm to give
       more standoff/collision clearance against the skull mesh, paired
       with moving the skull's registration 10cm farther from base_link),
       not independently calibrated - verify against the
       physical probe if precise real-world accuracy at the rod tip
       matters. Extends along +Z, matching this URDF's existing convention
       (every joint's origin in this chain has its dominant offset along
       the parent's +Z, i.e. +Z is "outward along the arm's reach"
       throughout). -->

  <joint name="hydrophone_rod_joint" type="fixed">
    <parent link="virtual_endeffector"/>
    <child link="hydrophone_rod"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="hydrophone_rod">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.075"/>
      <geometry>
        <cylinder radius="0.002" length="0.15"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.075"/>
      <geometry>
        <cylinder radius="0.002" length="0.15"/>
      </geometry>
    </collision>
  </link>

  <!-- Rod-tip reference frame: a zero-size frame at the FAR
       end of the rod (z=0.15 relative to virtual_endeffector as of the
       rod lengthening, matching the cylinder's own far face).
       MoveIt's planning group tip_link now
       points HERE (see cyton_gamma_1500.srdf), not virtual_endeffector -
       reversing the original decision. IK/Cartesian targets
       now refer to the actual physical probe tip directly; no more manual
       10cm accounting when picking targets. This also fixes a real,
       observed problem with the old setup: standoff was being measured
       from virtual_endeffector, so the rod (extending 10cm further)
       could be driven straight through a target surface even though the
       commanded pose was nominally "10mm short" of it - the arm was
       satisfying the standoff at the wrong point on itself. Now that the
       tip itself is what's commanded to stop short, the rod naturally
       clears the surface it's approaching. -->
  <joint name="hydrophone_tip_joint" type="fixed">
    <parent link="hydrophone_rod"/>
    <child link="hydrophone_tip"/>
    <origin rpy="0 0 0" xyz="0 0 0.15"/>
  </joint>

  <link name="hydrophone_tip"/>

</robot>